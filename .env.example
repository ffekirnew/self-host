# Copy to .env and fill in. .env is gitignored.

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install command token
CLOUDFLARE_TUNNEL_TOKEN=

# NordVPN *service credentials* (Nord Account → NordVPN → Manual setup), not your account login
NORDVPN_USER=
NORDVPN_PASSWORD=

# Tandoor: generated by tandoor/bootstrap.sh if empty
TANDOOR_SECRET_KEY=
TANDOOR_DB_PASSWORD=

# AdventureLog: generated by adventurelog/bootstrap.sh if empty
ADVENTURELOG_SECRET_KEY=
ADVENTURELOG_DB_PASSWORD=
ADVENTURELOG_ADMIN_PASSWORD=
